{
  "manifest_version": 3,
  "name": "Flight Currency for Google Flights",
  "description": "Choose your preferred Google Flights currency. Automatically show flight prices in USD, EUR, GBP, CAD, AUD, JPY, INR and more.",
  "version": "1.1.3",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "action": {
    "default_title": "Flight Currency",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/toolbar-16.png",
      "32": "images/toolbar-32.png"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [{
    "matches": ["https://www.google.com/travel/*", "https://google.com/travel/*"],
    "js": ["currencies.js", "currency.js", "content.js"],
    "run_at": "document_start"
  }]
}
